# Lance wakfu-prepare sur INPUTS (liste) vers OUT et compare base/, tu2/ et patched/ à REF.
# Si ISO est donné, l'image est d'abord générée depuis REF/base à ISO_OFFSET (test_extract make-xiso).
# Les sorties (dans le dossier de build) sont supprimées après une comparaison réussie.
foreach(v EXE GEN REF OUT INPUTS)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "variable ${v} manquante")
    endif()
endforeach()
file(REMOVE_RECURSE ${OUT})
if(DEFINED ISO)
    execute_process(COMMAND ${GEN} make-xiso ${REF}/base ${ISO} ${ISO_OFFSET} RESULT_VARIABLE r)
    if(r)
        message(FATAL_ERROR "génération de l'image : ${r}")
    endif()
endif()
execute_process(COMMAND ${EXE} -o ${OUT} ${INPUTS} RESULT_VARIABLE r)
if(r)
    message(FATAL_ERROR "wakfu-prepare : code ${r}")
endif()

function(compare_tree a b)
    file(GLOB_RECURSE la RELATIVE ${a} ${a}/*)
    file(GLOB_RECURSE lb RELATIVE ${b} ${b}/*)
    list(SORT la)
    list(SORT lb)
    if(NOT la STREQUAL lb)
        message(FATAL_ERROR "listes différentes : ${a} / ${b}")
    endif()
    foreach(f ${la})
        file(SHA256 ${a}/${f} ha)
        file(SHA256 ${b}/${f} hb)
        if(NOT ha STREQUAL hb)
            message(FATAL_ERROR "contenu différent : ${f}")
        endif()
    endforeach()
    list(LENGTH la n)
    message(STATUS "${b} : ${n} fichiers identiques")
endfunction()

compare_tree(${REF}/base ${OUT}/base)
compare_tree(${REF}/tu2 ${OUT}/tu2)
foreach(f default.xex image.bin patched.txt)
    file(SHA256 ${REF}/patched/${f} ha)
    file(SHA256 ${OUT}/patched/${f} hb)
    if(NOT ha STREQUAL hb)
        message(FATAL_ERROR "patched/${f} différent")
    endif()
endforeach()
message(STATUS "patched : default.xex, image.bin, patched.txt identiques")
file(REMOVE_RECURSE ${OUT})
if(DEFINED ISO)
    file(REMOVE ${ISO})
endif()
